# ============================================================================
# ENVIRONMENT VARIABLES - Supabase Monitoring Stack
# ComplicesConecta v3.9.2
# ============================================================================

# Supabase Service Role Key (para Metrics API)
# Obtener de: Project Settings → API → service_role (secret)
# IMPORTANTE: Nunca compartir esta clave pública
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-password

# Opcional: Alertmanager Configuration
# ALERTMANAGER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# ALERTMANAGER_PAGERDUTY_API_KEY=your-pagerduty-api-key
