{
  "name": "complices-conecta-sw",
  "private": true,
  "version": "3.5.1",
  "type": "module",
  "scripts": {
    "vercel-build": "npm run build",
    "dev": "vite",
    "dev:tunnel": "concurrently \"npm run dev\" \"npm run tunnel:ngrok\"",
    "tunnel:ngrok": "ngrok http 8080",
    "tunnel:cloudflare": "cloudflared tunnel --url http://localhost:8080",
    "tunnel:lt": "lt --port 8080",
    "tunnel:vercel": "vercel dev",
    "build": "vite build",
    "build:check": "tsc --noEmit --skipLibCheck && vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "backfill:s2": "tsx scripts/backfill-s2-cells.ts",
    "sync:neo4j": "tsx scripts/sync-postgres-to-neo4j.ts",
    "verify:neo4j": "tsx scripts/verify-neo4j.ts",
    "setup:neo4j-indexes": "tsx scripts/setup-neo4j-indexes.ts",
    "explain:analyze:remote": "tsx scripts/run-explain-analyze-remote.ts",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run test:run && npm run test:e2e",
    "type-check": "node scripts/type-check.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:demo": "playwright test demo-flow",
    "test:e2e:basic": "playwright test demo-flow --workers=1",
    "test:e2e:all": "playwright test demo-flow navigation-complete phone-validation ui-components registration-complete chat-realtime matches-likes galleries tokens-system clubs geolocation stories invitations comments moderation staking-nfts ai-verification components-theme --workers=1",
    "test:integration": "vitest run tests/integration",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "audit:check": "node scripts/audit-checker.js",
    "audit:security": "npm audit && npm run audit:check",
    "precommit": "npm run lint && npm run type-check && npm run test",
    "scaffold:templates": "tsx scripts/import-templates.ts",
    "audit:repo": "tsx scripts/audit-project.ts --report",
    "audit:fix": "tsx scripts/audit-project.ts --fix",
    "test:lint-robust": "node scripts/test-lint-robust.cjs",
    "test:type-robust": "node scripts/test-type-check-robust.cjs",
    "validate:types": "node scripts/validate-supabase-types.cjs",
    "build:analyze": "vite build --mode production && vite-bundle-visualizer",
    "grok:verify": "node scripts/verify-grok.js",
    "apidog:verify": "node scripts/verify-apidog.js",
    "update:types": "echo 'Para regenerar tipos ejecutar: npx supabase gen types typescript --project-id YOUR_PROJECT_ID > src/types/supabase.ts'",
    "security:progress": "node scripts/security-progress-check.js",
    "token:verify": "node scripts/verify-token.js",
    "security:scan": "node scripts/security-check.js",
    "prepare": "echo 'Husky prepare script disabled for deployment compatibility'"
  },
