# Don't ignore package-lock.json - Vercel needs it for dependency resolution
# package-lock.json

# Ignore GitHub workflows
.github/

# Ignore development files
.env.local
.env.development
*.log

# Ignore build artifacts that might cause conflicts
node_modules/
dist/
.cache/

# Ignore test files and coverage
coverage/
playwright-report/
playwright-report-e2e/
test-results/
*.spec.ts
*.test.ts
*.test.tsx
src/tests/

# Ignore development tools
.vscode/
*.code-workspace
check-imports*.ps1
eslint.config copy.js

# Ignore documentation and reports
IMPORT_AUDIT_REPORT.md
IMPORT_CORRECTIONS_REPORT.md
*.md
!README.md
# PERO los documentos legales de public/ SÍ se despliegan: sin esta
# excepción el `*.md` de arriba excluía public/docs/legal/*.md del
# deploy a Vercel y /docs/legal/TERMS_OF_SERVICE.md daba 404 en vivo
# (el build local sí los copia a dist/docs/legal/). El fetch de
# TokensLegal recibía entonces el index.html del fallback SPA.
!public/docs/legal/*.md

# Ignore Android build files (too large for Vercel)
android/
*.apk
*.aab
sentry-wizard.exe
dist/app-release.apk
public/app-release.apk