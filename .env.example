# ComplicesConecta v3.5.0 - Variables de Entorno Ejemplo
# Copia este archivo a .env.local y configura tus valores reales
# NO COMMITEAR SECRETOS REALES

# Modo de Aplicación (demo/production/development)
VITE_APP_MODE="demo"

# Credenciales Demo (Para testing - usa valores seguros)
# C4/C5 (2026-11-19): ELIMINADAS las variables VITE_DEMO_PASSWORD_*,
# VITE_PROD_PASSWORD_* y VITE_ADMIN_PASSWORD. Las variables VITE_* se
# incrustan en el bundle del navegador y NO son secretas. El login real es
# Supabase Auth; el modo demo es local y sin contraseña, y nunca es admin.
# Si alguna de esas contraseñas se usó alguna vez en un entorno real, ROTARLA.

# Admin Credentials (Para acceso al panel de administración)
VITE_ADMIN_EMAIL="complicesconectasw@outlook.es"
# C4/C5 (2026-11-19): VITE_ADMIN_PASSWORD eliminada (ver nota arriba).

# Admins de producción (lista separada por comas). Si se define, tiene prioridad sobre VITE_ADMIN_EMAIL.
VITE_PROD_ADMIN_EMAILS="complicesconectasw@outlook.es,djwacko28@gmail.com"

# Admin secundario (alternativa si no quieres lista)
VITE_PROD_ADMIN_EMAIL_2="djwacko28@gmail.com"

# Exentos de auditoría de acceso a evidencia legal (Edge Function: legal-evidence)
LEGAL_AUDIT_EXEMPT_EMAILS="complicesconectasw@outlook.es,djwacko28@gmail.com"

# Supabase Configuration
VITE_SUPABASE_URL="your_supabase_url_here"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Seguridad de Almacenamiento
# C4/C5 (2026-11-19): VITE_STORAGE_ENCRYPTION_KEY ELIMINADA. El almacenamiento
# seguro del cliente era reversible (clave fija en el bundle) y ahora es un
# stub fail-closed (src/lib/storage/secure-storage.ts). No guardar secretos
# en localStorage; lo secreto vive en el servidor.

# Configuración de Seguridad
VITE_APP_VERSION="1.0.0"
VITE_SESSION_TIMEOUT_MS="1800000"  # 30 minutos en milisegundos
VITE_ENABLE_SESSION_HIJACKING_DETECTION="true"

# Certificate Pinning (Android/iOS) + Web Hardening
# Hosts separados por coma (solo hostname, sin protocolo). Ej:
# VITE_PINNED_CERT_HOSTS="axtvqnozatbmllvwzuim.supabase.co,api.openai.com"
VITE_PINNED_CERT_HOSTS=""
# Fingerprints SHA-256 separados por coma en el mismo orden que hosts.
# Ej: "50:4B:...:26" (se normaliza internamente)
VITE_PINNED_CERT_FINGERPRINTS=""
# Controles web/desktop (PROD)
VITE_ENFORCE_HTTPS_IN_PROD="true"
VITE_ENFORCE_HOST_ALLOWLIST_IN_PROD="true"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
SUPABASE_JWT_SECRET="your_supabase_jwt_secret_here"

# AI Features
VITE_AI_NATIVE_ENABLED="true"
VITE_AI_CHAT_SUMMARIES_ENABLED="true"
# JWT complement (2026-11-19): VITE_OPENAI_API_KEY ELIMINADA. La clave de
# OpenAI vive solo como secreto del servidor (OPENAI_API_KEY en la Edge
# Function openai-proxy); el cliente llama al proxy con el JWT de sesión.
# No poner ninguna clave de OpenAI en variables VITE_* (van al bundle).

# Monitoring & Observability
VITE_SENTRY_DSN="your_sentry_dsn_here"
VITE_DATADOG_CLIENT_TOKEN="your_datadog_client_token_here"
VITE_DATADOG_APP_ID="your_datadog_app_id_here"
NEW_RELIC_LICENSE_KEY="your_new_relic_license_key_here"

# Neo4j Configuration (si habilitado)
VITE_NEO4J_ENABLED="true"
VITE_NEO4J_URI="bolt://localhost:8080"
VITE_NEO4J_USER="neo4j"
# C4/C5 (2026-11-19): VITE_NEO4J_PASSWORD ELIMINADA. La contraseña de Neo4j
# solo se lee del entorno del servidor (NEO4J_PASSWORD, sin prefijo VITE_);
# sin ella el driver no se inicializa. Si se usó el valor anterior, ROTARLA.
VITE_NEO4J_DATABASE="neo4j"

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY="your_stripe_publishable_key_here"
STRIPE_SECRET_KEY="your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret_here"

# hCaptcha Configuration
VITE_HCAPTCHA_SITE_KEY="your_hcaptcha_site_key_here"
VITE_HCAPTCHA_SECRET="your_hcaptcha_secret_here"

# World ID Configuration
WORLD_APP_SECRET="your_world_app_secret_here"
WORLD_VERIFY_ENDPOINT="https://developer.worldcoin.org/api/v1/verify"
NEXT_PUBLIC_WORLD_APP_ID="your_world_app_id_here"

#Grok
VITE_ONESIGNAL_APP_ID="tu-app-id-de-onesignal"
VITE_ONESIGNAL_SAFARI_WEB_ID="web.onesignal.auto.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
VITE_POSTHOG_HOST="https://app.posthog.com"
VITE_POSTHOG_KEY="phc_tu_key_aqui"
VITE_AUTO_DARK_MODE="true"
# Grok 4 (xAI Official) API Key
GROK_API_KEY="your_grok_api_key_here"

# Apidog API Configuration
VITE_APIDOG_API_KEY="your_apidog_api_key_here"
VITE_APIDOG_BASE_URL="https://api.apidog.com/v1"
VITE_APIDOG_TEAM_ID="your_team_id_here"
VITE_APIDOG_PROJECT_ID="your_project_id_here"
VITE_APIDOG_TIMEOUT="30000"

# Blockchain Configuration (v3.7.0)
VITE_DEMO_MODE="true"
# JWT complement (2026-11-19): VITE_WALLET_ENCRYPTION_KEY ELIMINADA. El
# cifrado de wallet exige ahora una passphrase explícita del usuario (patrón
# C4); sin ella no se cifra ni descifra. Rotar la clave vieja: estuvo en el
# bundle del navegador y las wallets guardadas con ella ya no se pueden
# descifrar con passphrase (hay que recrearlas).
MUMBAI_RPC_URL="https://rpc-mumbai.maticvigil.com"
POLYGON_RPC_URL="https://polygon-rpc.com"
PRIVATE_KEY="your_private_key_here_for_deployment"
POLYGONSCAN_API_KEY="your_polygonscan_api_key_here"
PINATA_API_KEY="your_pinata_api_key_here"
PINATA_SECRET_API_KEY="your_pinata_secret_key_here"

# ==========================================
# SENTRY CONFIGURATION (PLAN GRATUITO)
# ==========================================
# NOTA: Para plan gratuito, solo necesitas el DSN
# El auth token es opcional para uploads de source maps

# Sentry DSN para error tracking (REQUERIDO)
# Obtener desde: https://sentry.io/settings/[org]/projects/[project]/keys/
# Formato: https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_DSN=""

# Sentry Auth Token (OPCIONAL para plan gratuito)
# Solo necesario si quieres subir source maps
# Obtener desde: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=""

# Sentry Organization y Project
SENTRY_ORG="complicesconecta"
SENTRY_PROJECT="complicesconecta"

# Sentry Environment
SENTRY_ENVIRONMENT="production"

# Deshabilitar uploads de source maps para plan gratuito
SENTRY_DISABLE_AUTO_UPLOAD="true"
