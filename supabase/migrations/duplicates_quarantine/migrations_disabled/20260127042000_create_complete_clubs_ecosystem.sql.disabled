CREATE INDEX IF NOT EXISTS idx_club_reviews_is_featured ON public.club_reviews(is_featured);

-- Índices para club_nfts
CREATE INDEX IF NOT EXISTS idx_club_nfts_club_id ON public.club_nfts(club_id);
CREATE INDEX IF NOT EXISTS idx_club_nfts_token_id ON public.club_nfts(token_id);
