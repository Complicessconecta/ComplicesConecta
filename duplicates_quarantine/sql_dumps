    LANGUAGE "plpgsql"
    AS $$
DECLARE
    code TEXT;
    exists_code BOOLEAN;
BEGIN
    LOOP
        code := UPPER(SUBSTRING(MD5(RANDOM()::TEXT || NOW()::TEXT) FROM 1 FOR 8));
        SELECT EXISTS(SELECT 1 FROM user_tokens WHERE referral_code = code) INTO exists_code;
        EXIT WHEN NOT exists_code;
    END LOOP;
    RETURN code;
END;
