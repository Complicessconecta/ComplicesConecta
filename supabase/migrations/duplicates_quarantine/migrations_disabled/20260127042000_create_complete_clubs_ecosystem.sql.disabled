-- ============================================================================
-- 🗂️ ARCHIVO EN CUARENTENA - NO EJECUTAR
-- Motivo: Archivo duplicado/backup identificado en auditoría Supabase v3.9.6
-- Fecha cuarentena: 4 Feb 2026
-- Justificación: Mantener como referencia histórica pero no ejecutar para evitar
--                conflictos con versiones activas ya aplicadas y false positives en build
-- Estado: Inactivo - Solo backup histórico
-- ============================================================================

-- ========================================
-- ECOSISTEMA COMPLETO DE CLUBS
-- ========================================

-- 1. TABLA PRINCIPAL DE CLUBS
CREATE TABLE IF NOT EXISTS public.clubs (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    name TEXT NOT NULL,
    slug TEXT NOT NULL UNIQUE,
    description TEXT NOT NULL,
    address TEXT NOT NULL,
    city TEXT NOT NULL,
    state TEXT NOT NULL,
    country TEXT,
    latitude DECIMAL(10, 8),
    longitude DECIMAL(11, 8),
    category TEXT NOT NULL DEFAULT 'standard' CHECK (category IN ('standard', 'premium', 'vip', 'exclusive', 'lounge', 'bar', 'restaurant')),
    membership_tier TEXT NOT NULL DEFAULT 'free' CHECK (membership_tier IN ('free', 'premium', 'vip', 'exclusive')),
    is_active BOOLEAN DEFAULT true NOT NULL,
    is_verified BOOLEAN DEFAULT false NOT NULL,
    average_rating DECIMAL(3, 2) DEFAULT 0.0 CHECK (average_rating >= 0 AND average_rating <= 5),
    check_in_count INTEGER DEFAULT 0,
    check_in_radius_meters INTEGER DEFAULT 100,
    owner_id UUID REFERENCES auth.users(id) ON DELETE SET NULL,
    member_count INTEGER DEFAULT 0,
    website TEXT,
    phone TEXT,
    email TEXT,
    logo_url TEXT,
    cover_image_url TEXT,
    instagram_url TEXT,
    facebook_url TEXT,
    twitter_url TEXT,
    capacity INTEGER,
    opening_hours JSONB DEFAULT '{}'::jsonb,
    features JSONB DEFAULT '[]'::jsonb,
    tags JSONB DEFAULT '[]'::jsonb,
    pricing JSONB DEFAULT '{}'::jsonb,
    dress_code TEXT,
    age_restriction INTEGER DEFAULT 18,
    music_genres JSONB DEFAULT '[]'::jsonb,
    special_events BOOLEAN DEFAULT false,
    reservations_required BOOLEAN DEFAULT false,
    parking_available BOOLEAN DEFAULT false,
    valet_parking BOOLEAN DEFAULT false,
    outdoor_seating BOOLEAN DEFAULT false,
    indoor_seating BOOLEAN DEFAULT false,
    vip_areas BOOLEAN DEFAULT false,
    bottle_service BOOLEAN DEFAULT false,
    dance_floor BOOLEAN DEFAULT false,
    live_music BOOLEAN DEFAULT false,
    dj_booth BOOLEAN DEFAULT false,
    hookah_available BOOLEAN DEFAULT false,
    smoking_allowed BOOLEAN DEFAULT false,
    accessibility_features JSONB DEFAULT '[]'::jsonb,
    security_features JSONB DEFAULT '[]'::jsonb,
    payment_methods JSONB DEFAULT '[]'::jsonb,
    cancellation_policy TEXT,
    refund_policy TEXT,
    house_rules TEXT,
    social_media JSONB DEFAULT '{}'::jsonb,
    contact_info JSONB DEFAULT '{}'::jsonb,
    operating_status TEXT DEFAULT 'open' CHECK (operating_status IN ('open', 'closed', 'temporary_closed', 'permanently_closed')),
    suspension_reason TEXT,
    suspended_at TIMESTAMPTZ,
    verification_status TEXT DEFAULT 'pending' CHECK (verification_status IN ('pending', 'verified', 'rejected', 'suspended')),
    verified_at TIMESTAMPTZ,
    verified_by UUID REFERENCES auth.users(id),
    rejection_reason TEXT,
    business_license TEXT,
    permit_number TEXT,
    insurance_info JSONB DEFAULT '{}'::jsonb,
    last_inspection_date DATE,
    inspection_score DECIMAL(3, 2),
    health_department_rating TEXT,
    fire_safety_compliance BOOLEAN DEFAULT false,
    noise_compliance BOOLEAN DEFAULT false,
    created_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
    updated_at TIMESTAMPTZ DEFAULT NOW() NOT NULL
);

-- 2. TABLA DE APLICACIONES DE CLUBS
CREATE TABLE IF NOT EXISTS public.club_applications (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    club_id UUID REFERENCES public.clubs(id) ON DELETE CASCADE,
    user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE,
    application_type TEXT NOT NULL CHECK (application_type IN ('new', 'verification', 'renewal', 'appeal')),
    status TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'under_review', 'approved', 'rejected', 'needs_more_info', 'withdrawn')),
    priority TEXT DEFAULT 'normal' CHECK (priority IN ('low', 'normal', 'high', 'urgent')),
    submitted_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
    reviewed_at TIMESTAMPTZ,
    reviewed_by UUID REFERENCES auth.users(id),
    review_notes TEXT,
    rejection_reason TEXT,
    approved_at TIMESTAMPTZ,
    expires_at TIMESTAMPTZ,
    documents JSONB DEFAULT '[]'::jsonb,
    additional_info JSONB DEFAULT '{}'::jsonb,
    communication_history JSONB DEFAULT '[]'::jsonb,
    created_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
    updated_at TIMESTAMPTZ DEFAULT NOW() NOT NULL
);

-- 3. TABLA DE EVENTOS DE CLUBS
CREATE TABLE IF NOT EXISTS public.club_events (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    club_id UUID REFERENCES public.clubs(id) ON DELETE CASCADE,
    title TEXT NOT NULL,
    description TEXT,
    event_type TEXT NOT NULL CHECK (event_type IN ('party', 'concert', 'dj_set', 'theme_night', 'special_event', 'private_event', 'tournament', 'workshop')),
    start_time TIMESTAMPTZ NOT NULL,
    end_time TIMESTAMPTZ NOT NULL,
    is_recurring BOOLEAN DEFAULT false,
    recurrence_pattern JSONB,
    max_capacity INTEGER,
    current_attendees INTEGER DEFAULT 0,
    ticket_price DECIMAL(10, 2),
    ticket_url TEXT,
    dress_code TEXT,
    age_restriction INTEGER,
    special_guests JSONB DEFAULT '[]'::jsonb,
    performers JSONB DEFAULT '[]'::jsonb,
    promotions JSONB DEFAULT '[]'::jsonb,
    images JSONB DEFAULT '[]'::jsonb,
    videos JSONB DEFAULT '[]'::jsonb,
    social_media_tags JSONB DEFAULT '[]'::jsonb,
    is_active BOOLEAN DEFAULT true,
    is_cancelled BOOLEAN DEFAULT false,
    cancellation_reason TEXT,
    created_by UUID REFERENCES auth.users(id),
    created_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
    updated_at TIMESTAMPTZ DEFAULT NOW() NOT NULL
);

-- 4. TABLA DE DESCUENTOS DE CLUBS
CREATE TABLE IF NOT EXISTS public.club_discounts (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    club_id UUID REFERENCES public.clubs(id) ON DELETE CASCADE,
    title TEXT NOT NULL,
    description TEXT,
    discount_type TEXT NOT NULL CHECK (discount_type IN ('percentage', 'fixed_amount', 'buy_one_get_one', 'happy_hour', 'ladies_night', 'special_event')),
    discount_value DECIMAL(10, 2) NOT NULL,
    min_amount DECIMAL(10, 2),
    max_discount DECIMAL(10, 2),
    applicable_items JSONB DEFAULT '[]'::jsonb,
    exclusions JSONB DEFAULT '[]'::jsonb,
    valid_from TIMESTAMPTZ NOT NULL,
    valid_until TIMESTAMPTZ,
    usage_limit INTEGER,
    current_usage INTEGER DEFAULT 0,
    user_limit INTEGER DEFAULT 1,
    member_only BOOLEAN DEFAULT false,
    verification_required BOOLEAN DEFAULT false,
    promo_code TEXT UNIQUE,
    is_active BOOLEAN DEFAULT true,
    conditions TEXT,
    created_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
    updated_at TIMESTAMPTZ DEFAULT NOW() NOT NULL
);

-- 5. TABLA DE CHECK-INS DE CLUBS
CREATE TABLE IF NOT EXISTS public.club_check_ins (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    club_id UUID REFERENCES public.clubs(id) ON DELETE CASCADE,
    user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE,
    check_in_time TIMESTAMPTZ DEFAULT NOW() NOT NULL,
    check_out_time TIMESTAMPTZ,
    duration_minutes INTEGER,
    purpose TEXT CHECK (purpose IN ('social', 'dating', 'business', 'event', 'other')),
    companions JSONB DEFAULT '[]'::jsonb,
    table_number TEXT,
    area TEXT,
    spent_amount DECIMAL(10, 2),
    payment_method TEXT,
    rating INTEGER CHECK (rating >= 1 AND rating <= 5),
    review TEXT,
    photos JSONB DEFAULT '[]'::jsonb,
    tags JSONB DEFAULT '[]'::jsonb,
    staff_interactions JSONB DEFAULT '[]'::jsonb,
    issues_reported JSONB DEFAULT '[]'::jsonb,
    is_verified BOOLEAN DEFAULT false,
    verified_by UUID REFERENCES auth.users(id),
    notes TEXT,
    created_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
    updated_at TIMESTAMPTZ DEFAULT NOW() NOT NULL
);

-- 6. TABLA DE RESEÑAS DE CLUBS
CREATE TABLE IF NOT EXISTS public.club_reviews (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    club_id UUID REFERENCES public.clubs(id) ON DELETE CASCADE,
    user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE,
    rating INTEGER NOT NULL CHECK (rating >= 1 AND rating <= 5),
    title TEXT,
    review TEXT NOT NULL,
    visit_date DATE,
    check_in_id UUID REFERENCES public.club_check_ins(id),
    service_rating INTEGER CHECK (service_rating >= 1 AND rating <= 5),
    atmosphere_rating INTEGER CHECK (atmosphere_rating >= 1 AND rating <= 5),
    value_rating INTEGER CHECK (value_rating >= 1 AND rating <= 5),
    cleanliness_rating INTEGER CHECK (cleanliness_rating >= 1 AND rating <= 5),
    staff_rating INTEGER CHECK (staff_rating >= 1 AND rating <= 5),
    music_rating INTEGER CHECK (music_rating >= 1 AND rating <= 5),
    crowd_rating INTEGER CHECK (crowd_rating >= 1 AND rating <= 5),
    safety_rating INTEGER CHECK (safety_rating >= 1 AND rating <= 5),
    would_recommend BOOLEAN,
    return_probability INTEGER CHECK (return_probability >= 0 AND return_probability <= 100),
    price_range TEXT CHECK (price_range IN ('$', '$$', '$$$', '$$$$', '$$$$')),
    visit_frequency TEXT CHECK (visit_frequency IN ('first_time', 'occasional', 'regular', 'frequent')),
    group_type TEXT CHECK (group_type IN ('solo', 'couple', 'friends', 'group', 'family')),
    occasion TEXT CHECK (occasion IN ('casual', 'date', 'celebration', 'business', 'special_event')),
    photos JSONB DEFAULT '[]'::jsonb,
    videos JSONB DEFAULT '[]'::jsonb,
    helpful_count INTEGER DEFAULT 0,
    response_from_club TEXT,
    response_date TIMESTAMPTZ,
    is_verified BOOLEAN DEFAULT false,
    is_featured BOOLEAN DEFAULT false,
    moderation_status TEXT DEFAULT 'pending' CHECK (moderation_status IN ('pending', 'approved', 'rejected', 'flagged')),
    flags JSONB DEFAULT '[]'::jsonb,
    created_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
    updated_at TIMESTAMPTZ DEFAULT NOW() NOT NULL
);

-- 7. TABLA DE NFTs DE CLUBS
CREATE TABLE IF NOT EXISTS public.club_nfts (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    club_id UUID REFERENCES public.clubs(id) ON DELETE CASCADE,
    token_id TEXT NOT NULL,
    token_standard TEXT NOT NULL CHECK (token_standard IN ('ERC721', 'ERC1155')),
    contract_address TEXT NOT NULL,
    blockchain TEXT NOT NULL DEFAULT 'polygon',
    name TEXT NOT NULL,
    description TEXT,
    image_url TEXT,
    animation_url TEXT,
    external_url TEXT,
    attributes JSONB DEFAULT '[]'::jsonb,
    rarity TEXT CHECK (rarity IN ('common', 'uncommon', 'rare', 'epic', 'legendary')),
    edition_number INTEGER,
    total_editions INTEGER,
    mint_date TIMESTAMPTZ,
    mint_price DECIMAL(18, 8),
    mint_currency TEXT DEFAULT 'matic',
    current_owner UUID REFERENCES auth.users(id),
    creator_royalty DECIMAL(5, 2) DEFAULT 0,
    is_transferable BOOLEAN DEFAULT true,
    transfer_count INTEGER DEFAULT 0,
    last_transfer_date TIMESTAMPTZ,
    is_burned BOOLEAN DEFAULT false,
    burn_date TIMESTAMPTZ,
    metadata JSONB DEFAULT '{}'::jsonb,
    created_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
    updated_at TIMESTAMPTZ DEFAULT NOW() NOT NULL
);

-- 8. TABLA DE SEGUIDORES DE CLUBS
CREATE TABLE IF NOT EXISTS public.club_followers (
    id UUID DEFAULT gen_random_uuid() PRIMARY KEY,
    club_id UUID REFERENCES public.clubs(id) ON DELETE CASCADE,
    user_id UUID REFERENCES auth.users(id) ON DELETE CASCADE,
    follow_type TEXT NOT NULL DEFAULT 'follow' CHECK (follow_type IN ('follow', 'favorite', 'member', 'vip')),
    status TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'inactive', 'suspended')),
    followed_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
    last_interaction TIMESTAMPTZ,
    interaction_count INTEGER DEFAULT 0,
    notification_preferences JSONB DEFAULT '{}'::jsonb,
    benefits JSONB DEFAULT '[]'::jsonb,
    membership_level TEXT CHECK (membership_level IN ('basic', 'premium', 'vip', 'exclusive')),
    expires_at TIMESTAMPTZ,
    auto_renew BOOLEAN DEFAULT false,
    created_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
    updated_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
    UNIQUE(club_id, user_id, follow_type)
);

