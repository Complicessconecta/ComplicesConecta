-- ========================================
-- TRIGGERS AUTOMÁTICOS
-- ========================================

-- Trigger para updated_at en todas las tablas
CREATE OR REPLACE FUNCTION public.handle_updated_at()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = NOW();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Aplicar triggers a todas las tablas
CREATE TRIGGER handle_clubs_updated_at BEFORE UPDATE ON public.clubs FOR EACH ROW EXECUTE FUNCTION public.handle_updated_at();
CREATE TRIGGER handle_club_applications_updated_at BEFORE UPDATE ON public.club_applications FOR EACH ROW EXECUTE FUNCTION public.handle_updated_at();
CREATE TRIGGER handle_club_events_updated_at BEFORE UPDATE ON public.club_events FOR EACH ROW EXECUTE FUNCTION public.handle_updated_at();
CREATE TRIGGER handle_club_discounts_updated_at BEFORE UPDATE ON public.club_discounts FOR EACH ROW EXECUTE FUNCTION public.handle_updated_at();
CREATE TRIGGER handle_club_check_ins_updated_at BEFORE UPDATE ON public.club_check_ins FOR EACH ROW EXECUTE FUNCTION public.handle_updated_at();
CREATE TRIGGER handle_club_reviews_updated_at BEFORE UPDATE ON public.club_reviews FOR EACH ROW EXECUTE FUNCTION public.handle_updated_at();
CREATE TRIGGER handle_club_nfts_updated_at BEFORE UPDATE ON public.club_nfts FOR EACH ROW EXECUTE FUNCTION public.handle_updated_at();
CREATE TRIGGER handle_club_followers_updated_at BEFORE UPDATE ON public.club_followers FOR EACH ROW EXECUTE FUNCTION public.handle_updated_at();

-- ========================================
-- POLÍTICAS RLS (ROW LEVEL SECURITY)
-- ========================================

-- Habilitar RLS en todas las tablas
ALTER TABLE public.clubs ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.club_applications ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.club_events ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.club_discounts ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.club_check_ins ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.club_reviews ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.club_nfts ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.club_followers ENABLE ROW LEVEL SECURITY;

-- Políticas para clubs (público puede ver clubs activos)
CREATE POLICY "Anyone can view active clubs" ON public.clubs FOR SELECT USING (is_active = true);
CREATE POLICY "Admins can manage all clubs" ON public.clubs FOR ALL USING (
    EXISTS (
        SELECT 1 FROM public.admin_users au 
        WHERE au.user_id = auth.uid() 
        AND au.is_active = true
    )
);

-- Políticas para club_applications
CREATE POLICY "Users can view own applications" ON public.club_applications FOR SELECT USING (user_id = auth.uid());
CREATE POLICY "Admins can manage all applications" ON public.club_applications FOR ALL USING (
    EXISTS (
        SELECT 1 FROM public.admin_users au 
        WHERE au.user_id = auth.uid() 
        AND au.is_active = true
    )
);

-- Políticas para club_events
CREATE POLICY "Anyone can view active events" ON public.club_events FOR SELECT USING (is_active = true AND NOT is_cancelled);
CREATE POLICY "Club owners can manage events" ON public.club_events FOR ALL USING (
    EXISTS (
        SELECT 1 FROM public.clubs c 
        WHERE c.id = club_events.club_id 
        AND c.owner_id = auth.uid()
    )
);
CREATE POLICY "Admins can manage all events" ON public.club_events FOR ALL USING (
    EXISTS (
        SELECT 1 FROM public.admin_users au 
        WHERE au.user_id = auth.uid() 
        AND au.is_active = true
    )
);

-- Políticas para club_discounts
CREATE POLICY "Anyone can view active discounts" ON public.club_discounts FOR SELECT USING (is_active = true AND valid_until > NOW());
CREATE POLICY "Club owners can manage discounts" ON public.club_discounts FOR ALL USING (
    EXISTS (
        SELECT 1 FROM public.clubs c 
        WHERE c.id = club_discounts.club_id 
        AND c.owner_id = auth.uid()
    )
);
CREATE POLICY "Admins can manage all discounts" ON public.club_discounts FOR ALL USING (
    EXISTS (
        SELECT 1 FROM public.admin_users au 
        WHERE au.user_id = auth.uid() 
        AND au.is_active = true
    )
);

-- Políticas para club_check_ins
CREATE POLICY "Users can view own check-ins" ON public.club_check_ins FOR SELECT USING (user_id = auth.uid());
CREATE POLICY "Club owners can view club check-ins" ON public.club_check_ins FOR SELECT USING (
    EXISTS (
        SELECT 1 FROM public.clubs c 
        WHERE c.id = club_check_ins.club_id 
        AND c.owner_id = auth.uid()
    )
);
CREATE POLICY "Admins can view all check-ins" ON public.club_check_ins FOR SELECT USING (
    EXISTS (
        SELECT 1 FROM public.admin_users au 
        WHERE au.user_id = auth.uid() 
        AND au.is_active = true
    )
);
CREATE POLICY "Users can create own check-ins" ON public.club_check_ins FOR INSERT WITH CHECK (user_id = auth.uid());
CREATE POLICY "Users can update own check-ins" ON public.club_check_ins FOR UPDATE USING (user_id = auth.uid());

-- Políticas para club_reviews
CREATE POLICY "Anyone can view verified reviews" ON public.club_reviews FOR SELECT USING (is_verified = true);
CREATE POLICY "Users can view own reviews" ON public.club_reviews FOR SELECT USING (user_id = auth.uid());
CREATE POLICY "Users can create own reviews" ON public.club_reviews FOR INSERT WITH CHECK (user_id = auth.uid());
CREATE POLICY "Users can update own reviews" ON public.club_reviews FOR UPDATE USING (user_id = auth.uid());
CREATE POLICY "Admins can manage all reviews" ON public.club_reviews FOR ALL USING (
    EXISTS (
        SELECT 1 FROM public.admin_users au 
        WHERE au.user_id = auth.uid() 
        AND au.is_active = true
    )
);

-- Políticas para club_nfts
CREATE POLICY "Anyone can view NFTs" ON public.club_nfts FOR SELECT USING (true);
CREATE POLICY "NFT owners can manage their NFTs" ON public.club_nfts FOR ALL USING (current_owner = auth.uid());
CREATE POLICY "Club owners can manage club NFTs" ON public.club_nfts FOR ALL USING (
    EXISTS (
        SELECT 1 FROM public.clubs c 
        WHERE c.id = club_nfts.club_id 
        AND c.owner_id = auth.uid()
    )
);
CREATE POLICY "Admins can manage all NFTs" ON public.club_nfts FOR ALL USING (
    EXISTS (
        SELECT 1 FROM public.admin_users au 
        WHERE au.user_id = auth.uid() 
        AND au.is_active = true
    )
);

-- Políticas para club_followers
CREATE POLICY "Users can manage own follows" ON public.club_followers FOR ALL USING (user_id = auth.uid());
CREATE POLICY "Anyone can view follower counts" ON public.club_followers FOR SELECT USING (status = 'active');
CREATE POLICY "Admins can view all follows" ON public.club_followers FOR SELECT USING (
    EXISTS (
        SELECT 1 FROM public.admin_users au 
        WHERE au.user_id = auth.uid() 
        AND au.is_active = true
    )
);

-- ========================================
-- DATOS DE DEMO
-- ========================================

-- Insertar clubs de demo con datos completos
INSERT INTO public.clubs (
    name, slug, description, address, city, state, country, latitude, longitude,
    category, membership_tier, is_active, is_verified, average_rating, check_in_count,
    member_count, website, phone, email, logo_url, cover_image_url, capacity,
    opening_hours, features, tags, pricing, dress_code, age_restriction,
