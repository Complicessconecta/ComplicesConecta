    IF ABS(NEW.amount) > 1000 THEN
        -- Log de auditoría simple (sin tabla audit_logs por ahora)
        RAISE NOTICE 'Transacción grande detectada: % tokens para usuario %', NEW.amount, NEW.user_id;
    END IF;
    
