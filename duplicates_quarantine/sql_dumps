    LANGUAGE "plpgsql"
    AS $$
DECLARE
  ban_id UUID;
  fingerprint_id UUID;
BEGIN
  -- Crear o actualizar fingerprint
  INSERT INTO digital_fingerprints (
    user_id,
    canvas_hash,
    worldid_nullifier_hash,
    combined_hash,
    is_banned,
    banned_at,
    ban_reason
  ) VALUES (
